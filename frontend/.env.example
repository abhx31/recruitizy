# Copy this file to `frontend/.env.local` for local development.
# In production, set these in the Vercel dashboard (Project Settings → Environment Variables).

# Backend API base URL. Must end in /api because the backend mounts every router under /api/...
# Local dev (backend running on localhost:8000): http://localhost:8000/api
# Production: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

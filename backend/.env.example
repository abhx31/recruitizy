# Copy this file to `backend/.env`. docker-compose reads it via `env_file: ./backend/.env`.

# --- Database (external: RDS / Neon / Supabase / etc.) ---
# Make sure the DB host allows connections from wherever the backend runs
# (your local IP for dev, the EC2 box's IP in production).
DATABASE_URL=postgresql://USER:PASSWORD@your-db-host.example.com:5432/recruitizy

# --- Redis ---
# Local dev (backend running on host): redis://localhost:6379/0
# Inside docker-compose this is overridden to redis://redis:6379/0 automatically.
REDIS_URL=redis://localhost:6379/0

# --- App security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# --- CORS: comma-separated list of frontend origins ---
# Local dev:  http://localhost:3000
# Production: https://your-app.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# --- NVIDIA / DeepSeek (AI scoring) ---
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=deepseek-ai/deepseek-v4-pro

# --- Email (Resend) ---
RESEND_API_KEY=re_...
# Display-name format helps with inbox placement vs raw `noreply@...`
EMAIL_FROM=Recruitizy <noreply@yourdomain.com>
# A real reachable inbox — `noreply@` without a reply-to looks like bulk mail
EMAIL_REPLY_TO=hello@yourdomain.com

# --- Frontend base URL (used for links in outgoing emails, e.g. verification) ---
# Local dev:  http://localhost:3000
# Production: https://recruitizy.vercel.app
FRONTEND_URL=http://localhost:3000

# --- AWS S3 (resume storage) ---
AWS_BUCKET_NAME=your-bucket
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
